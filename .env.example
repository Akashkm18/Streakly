# Streakly Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL in production, SQLite in local dev)
DATABASE_URL=file:./dev.db
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/streakly?schema=public

# Authentication & JWT Secrets (32+ characters required in production)
JWT_ACCESS_SECRET=streakly_super_secret_access_jwt_key_32chars_min_length!
JWT_REFRESH_SECRET=streakly_super_secret_refresh_jwt_key_32chars_min_length!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP Configuration (Gmail or Mailpit)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_SECURE=false
MAIL_FROM="Streakly <your-email@gmail.com>"

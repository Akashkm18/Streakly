datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  passwordHash        String
  name                String
  avatarUrl           String?
  timezone            String             @default("UTC")
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  habits              Habit[]
  checkIns            CheckIn[]
  freezes             Freeze[]
  restDays            RestDay[]
  goals               Goal[]
  userBadges          UserBadge[]
  reminders           Reminder[]
  refreshTokens       RefreshToken[]
  resetOtps           PasswordResetOtp[]
  auditLogs           AuditLog[]
}

model Category {
  id        String          @id @default(uuid())
  name      String          @unique
  icon      String
  color     String
  order     Int             @default(0)
  templates HobbyTemplate[]
  habits    Habit[]
}

model HobbyTemplate {
  id                  String    @id @default(uuid())
  categoryId          String
  category            Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name                String    @unique
  description         String
  icon                String
  color               String
  defaultUnit         String
  suggestedGoal       Float
  scheduleType        String    @default("EVERY_DAY")
  defaultDays         String?
  defaultTimesPerWeek Int?
}

model Habit {
  id                 String      @id @default(uuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId         String?
  category           Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  icon               String      @default("sparkles")
  color              String      @default("#4F46E5")
  unit               String      @default("times")
  targetAmount       Float       @default(1)
  scheduleType       String      @default("EVERY_DAY")
  scheduleDays       String?
  timesPerWeek       Int?        @default(7)
  currentStreak      Int         @default(0)
  longestStreak      Int         @default(0)
  weeklyStreak       Int         @default(0)
  totalCheckIns      Int         @default(0)
  personalBestAmount Float       @default(0)
  isArchived         Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  checkIns           CheckIn[]
  goals              Goal[]
  reminders          Reminder[]
  restDays           RestDay[]

  @@index([userId, isArchived])
}

model CheckIn {
  id        String   @id @default(uuid())
  userId    String
  habitId   String
  date      String
  timestamp DateTime @default(now())
  amount    Float    @default(1)
  note      String?
  effort    Int?
  isFrozen  Boolean  @default(false)
  isRestDay Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, habitId, date])
}

model Freeze {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  monthKey  String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, monthKey])
}

model RestDay {
  id        String   @id @default(uuid())
  userId    String
  habitId   String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit     Habit?   @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      String
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Goal {
  id            String   @id @default(uuid())
  userId        String
  habitId       String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit         Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  title         String
  targetAmount  Float
  unit          String
  deadline      String
  currentAmount Float    @default(0)
  isCompleted   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, habitId])
}

model Badge {
  id          String      @id @default(uuid())
  key         String      @unique
  name        String
  description String
  icon        String
  tier        String      @default("BRONZE")
  userBadges  UserBadge[]
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Reminder {
  id           String   @id @default(uuid())
  userId       String
  habitId      String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit        Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  reminderTime String
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([userId, habitId])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  familyId   String
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
}

model PasswordResetOtp {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash             String
  attempts            Int       @default(0)
  maxAttempts         Int       @default(5)
  expiresAt           DateTime
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  isUsed              Boolean   @default(false)
  createdAt           DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     String
  ipAddress String?
  userAgent String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([event, createdAt])
}

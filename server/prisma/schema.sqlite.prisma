datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  passwordHash        String
  name                String
  avatarUrl           String?
  timezone            String             @default("UTC")
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  habits              Habit[]
  checkIns            CheckIn[]
  freezes             Freeze[]
  restDays            RestDay[]
  goals               Goal[]
  userBadges          UserBadge[]
  reminders           Reminder[]
  refreshTokens       RefreshToken[]
  resetOtps           PasswordResetOtp[]
  auditLogs           AuditLog[]
}

model Category {
  id        String          @id @default(uuid())
  name      String          @unique
  icon      String          // Lucide icon key
  color     String          // Category hex color
  order     Int             @default(0)
  templates HobbyTemplate[]
  habits    Habit[]
}

model HobbyTemplate {
  id                  String    @id @default(uuid())
  categoryId          String
  category            Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name                String    @unique
  description         String
  icon                String
  color               String
  defaultUnit         String    // "mins", "pages", "km", "reps", "glasses", "sessions", "rupees"
  suggestedGoal       Float     // e.g. 30, 10, 5
  scheduleType        String    @default("EVERY_DAY") // EVERY_DAY, SPECIFIC_DAYS, TIMES_PER_WEEK
  defaultDays         String?   // JSON string e.g. '["MON","WED","FRI"]'
  defaultTimesPerWeek Int?      // e.g. 3
}

model Habit {
  id                 String      @id @default(uuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId         String?
  category           Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  icon               String      @default("sparkles")
  color              String      @default("#4F46E5")
  unit               String      @default("times")
  targetAmount       Float       @default(1)
  scheduleType       String      @default("EVERY_DAY") // EVERY_DAY, SPECIFIC_DAYS, TIMES_PER_WEEK
  scheduleDays       String?     // JSON array e.g. '["MON","WED","FRI"]'
  timesPerWeek       Int?        @default(7)
  currentStreak      Int         @default(0)
  longestStreak      Int         @default(0)
  weeklyStreak       Int         @default(0)
  totalCheckIns      Int         @default(0)
  personalBestAmount Float       @default(0)
  isArchived         Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  checkIns           CheckIn[]
  goals              Goal[]
  reminders          Reminder[]
  restDays           RestDay[]

  @@index([userId, isArchived])
}

model CheckIn {
  id        String   @id @default(uuid())
  userId    String
  habitId   String
  date      String   // YYYY-MM-DD
  timestamp DateTime @default(now())
  amount    Float    @default(1)
  note      String?
  effort    Int?     // 1-5 rating
  isFrozen  Boolean  @default(false)
  isRestDay Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, habitId, date])
}

model Freeze {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  monthKey  String   // YYYY-MM
  reason    String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, monthKey])
}

model RestDay {
  id        String   @id @default(uuid())
  userId    String
  habitId   String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit     Habit?   @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  reason    String   // "Sick", "Travel", "Rest"
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Goal {
  id            String   @id @default(uuid())
  userId        String
  habitId       String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit         Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  title         String   // e.g. "Read 12 books by Dec 31"
  targetAmount  Float
  unit          String
  deadline      String   // YYYY-MM-DD
  currentAmount Float    @default(0)
  isCompleted   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, habitId])
}

model Badge {
  id          String      @id @default(uuid())
  key         String      @unique // streak-7, streak-30, streak-100, streak-365, first-checkin, 10-hobbies, personal-record, perfect-week
  name        String
  description String
  icon        String
  tier        String      @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  userBadges  UserBadge[]
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Reminder {
  id           String   @id @default(uuid())
  userId       String
  habitId      String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit        Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  reminderTime String   // "HH:MM" e.g. "08:30"
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([userId, habitId])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  familyId   String   // Grouping for token rotation family
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
}

model PasswordResetOtp {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash             String    // SHA-256 hash of 6-digit OTP
  attempts            Int       @default(0)
  maxAttempts         Int       @default(5)
  expiresAt           DateTime  // 10 minutes from creation
  resetTokenHash      String?   // Hash of 10-min single-use reset token
  resetTokenExpiresAt DateTime?
  isUsed              Boolean   @default(false)
  createdAt           DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     String   // LOGIN_SUCCESS, LOGIN_FAILED, ACCOUNT_LOCKED, PASSWORD_CHANGED, PASSWORD_RESET_REQUESTED, PASSWORD_RESET_SUCCESS, LOGOUT
  ipAddress String?
  userAgent String?
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([event, createdAt])
}
